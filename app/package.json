{
  "name": "chinword",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ChinWord — 중국어 어휘 학습 PWA",
  "scripts": {
    "build-content": "tsx scripts/build-content.ts",
    "build:hsk": "tsx scripts/build-hsk.ts",
    "build:hsk:translate": "tsx scripts/translate-hsk.ts",
    "build:tts": "tsx scripts/build-tts.ts",
    "dev": "npm run build-content && vite",
    "build": "npm run build-content && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hanzi-writer": "^3.7.2",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.453.0",
    "minisearch": "^7.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "msedge-tts": "^2.0.5",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.5",
    "vite-plugin-pwa": "^0.20.5"
  }
}
